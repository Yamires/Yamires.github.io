---
import { researchPoster } from "../data/research-poster";
---

<details
  id="original-poster"
  class="poster-viewer"
  data-poster-viewer
  data-embed-url={researchPoster.embedUrl}
  data-viewer-title={researchPoster.title}
>
  <summary>View original poster · Canva</summary>
  <div class="poster-viewer-body">
    <p class="metadata">
      The original poster is hosted by Canva. If it does not load here, use
      “Open in Canva” or download the PDF above.
    </p>
    <noscript>
      <p class="metadata">
        Use the Canva link or PDF download to view the original poster. The web
        narrative below remains fully available.
      </p>
    </noscript>
    <div
      class="poster-viewer-frame"
      data-poster-frame
      hidden
    ></div>
  </div>
</details>
<script>
  import "../scripts/poster-viewer";
</script>
