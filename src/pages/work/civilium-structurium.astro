---
import Base from "../../layouts/Base.astro";
import { publishedProjects } from "../../lib/projects";
import { href } from "../../lib/paths";

const project = (await publishedProjects()).find(
  (entry) => entry.id === "civilium-structurium",
);
if (!project) return Astro.redirect(href("work/"));
const demoUrl = href("civilium/index.html");
---

<Base
  title={project.data.title}
  description={project.data.summary}
  active="work"
>
  <header class="page-masthead">
    <p class="breadcrumb">
      <a href={href("work/")}>Work</a>
      <span aria-hidden="true">/</span>Civilium Structurium
    </p>
    <p class="eyebrow">Software / interactive demo</p>
    <h1>Civilium Structurium</h1>
    <p class="lead">{project.data.summary}</p>
    <p class="metadata">{project.data.date_display} · Browser-based demo</p>
  </header>
  <aside
    class="calculator-phone-notice"
    aria-labelledby="calculator-device-heading"
  >
    <h2 id="calculator-device-heading">Open on a tablet or desktop</h2>
    <p>
      This calculator is designed for larger screens. Please visit this page on
      a tablet or computer to use the interactive demo.
    </p>
  </aside>
  <div class="calculator-desktop">
    <div id="calculator-container"></div>
    <template id="calculator-template">
      <iframe
        class="calculator-frame"
        src={demoUrl}
        title="Civilium Structurium calculator"
        width="100%"
        height="900"
        loading="lazy"
      ></iframe>
    </template>
    <noscript>
      <p>Use the link below to open the calculator in a separate tab.</p>
    </noscript>
    <p class="calculator-link">
      <a href={demoUrl} target="_blank" rel="noopener">
        Open the calculator in a separate tab
      </a>
    </p>
  </div>
  <a class="section-end-link" href={href("work/")}>
    Back to Work →
  </a>
</Base>

<script>
  const container = document.querySelector("#calculator-container");
  const template = document.querySelector<HTMLTemplateElement>(
    "#calculator-template",
  );
  const screen = window.matchMedia("(min-width: 768px)");
  function updateCalculator() {
    if (!container || !template) return;
    if (screen.matches) {
      if (!container.hasChildNodes())
        container.append(template.content.cloneNode(true));
    } else {
      container.replaceChildren();
    }
  }
  updateCalculator();
  screen.addEventListener("change", updateCalculator);
</script>

<style>
  .calculator-desktop {
    display: none;
  }
  .calculator-phone-notice {
    padding-block: 24px;
    border-block: 1px solid var(--rule);
  }
  .calculator-phone-notice h2 {
    margin-bottom: 12px;
  }
  @media (min-width: 768px) {
    .calculator-desktop {
      display: block;
    }
    .calculator-phone-notice {
      display: none;
    }
  }
  .calculator-frame {
    display: block;
    width: 100%;
    border: 0;
    border-radius: 12px;
  }
  .calculator-link {
    margin-block: 20px;
  }
  @media print {
    .calculator-frame {
      display: none;
    }
  }
</style>
