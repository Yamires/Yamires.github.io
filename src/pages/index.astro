---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { profile } from "../data/profile";
import { href } from "../lib/paths";
import { publishedProjects } from "../lib/projects";
import Photography from "../components/Photography.astro";
const projects = (await publishedProjects())
  .filter((project) => project.data.featured)
  .slice(0, 3);
---

<Base title="About" active="about">
  <div class="home-intro">
    <p class="eyebrow">
      {profile.headline} <span class="inline-divider">/</span>{" "}
      {profile.affiliation}
    </p>
    <h1>{profile.name}</h1>
    <p class="intro-statement">
      Building maintainable software
      <br class="desktop-break" /> and studying how it evolves
      <span class="accent">.</span>
    </p>
    <p class="intro-support">
      Python, Java, full-stack development, and software testing.
    </p>
    <div class="link-group">
      <a class="action-link" href={href("cv/")}>
        View CV <span aria-hidden="true">→</span>
      </a>
      <a href="#selected-work">
        Selected work <span aria-hidden="true">↓</span>
      </a>
    </div>
    <div class="intro-index" aria-hidden="true">
      <span>FIELD NOTES</span>
      <span>01 — 05</span>
    </div>
  </div>

  <Section id="about" number="01" title="Who am I">
    <div class="about-grid">
      <div class="prose">
        <p class="lead">
          I develop software in Python and Java, with experience in full-stack
          applications, automated testing, and repository analysis. I’m pursuing
          a master’s in Programming and Software Engineering at Université de
          Montréal, focused on software architecture and maintainable systems.
        </p>
        <p>
          At GEODES, I study how changing domain knowledge shapes software
          evolution, continuing work begun during my research internship.
          Outside software and research, I enjoy travelling and photography.
        </p>
      </div>
      <aside class="interest-rail" aria-label="Interests">
        <p class="eyebrow">Interests</p>
        <ul>
          <li>Software architecture</li>
          <li>Domain modeling</li>
          <li>Software evolution</li>
        </ul>
        <p class="metadata">
          {profile.program}
          <br />
          Expected completion {profile.expectedGraduation}
        </p>
      </aside>
    </div>
  </Section>
  <Section id="selected-work" number="02" title="Selected work">
    {projects.map((project, index) => (
      <ProjectRow project={project} index={index + 1} />
    ))}
    <a class="section-end-link" href={href("work/")}>
      All work →
    </a>
  </Section>
  <Section id="background" number="03" title="Experience & skills">
    <div class="split-action">
      <p class="prose">
        Development, research, teaching, and professional experience.
      </p>
      <a class="action-link" href={href("cv/")}>
        View CV →
      </a>
    </div>
  </Section>
  <Section id="photography" number="04" title="Selected photographs">
    <p class="prose">Travel and photography beyond the code.</p>
    <Photography />
  </Section>
  <Section id="contact" number="05" title="Get in touch">
    <div class="split-action">
      <div>
        <p class="lead">Let’s discuss software or research.</p>
        <a class="contact-email" href={`mailto:${profile.email}`}>
          {profile.email} <span aria-hidden="true">↗</span>
        </a>
        <p class="metadata contact-secondary">
          Personal:{" "}
          <a href={`mailto:${profile.personalEmail}`}>
            {profile.personalEmail}
          </a>
        </p>
      </div>
      <div>
        <p class="metadata">{profile.affiliation}</p>
        <div class="link-group">
          <a href={profile.github}>GitHub ↗</a>
          <a href={profile.linkedin}>LinkedIn ↗</a>
        </div>
      </div>
    </div>
  </Section>
</Base>
